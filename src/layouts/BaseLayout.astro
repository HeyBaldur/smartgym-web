---
import type { Lang } from '../utils/i18n';
import Animations from '../components/Animations.astro';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  image?: string;
}

const { title, description, lang = 'en', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = image ?? `https://heybaldur.github.io${base}og-image.svg`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://heybaldur.github.io');
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content="_zqB9YZ3Tv8z2IcN8INnap8FkDhpzKRWpDS0ds2_m1o" />

    <link rel="icon" type="image/png" href={`${base}icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-black text-white min-h-screen font-sans antialiased">
    <slot />
    <Animations />
  </body>
</html>
