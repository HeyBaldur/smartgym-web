        <div class="flex items-center gap-1.5 mt-2.5">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#003399]/30 border border-[#003399]/50 text-[#6ba3ff] text-[10px] font-semibold">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10.5c0 6.624 5.376 12 12 12s12-5.376 12-12a11.955 11.955 0 00-.598-3.75A11.959 11.959 0 0015 2.714m-3-1.75v2"/>
            </svg>
            GDPR Compliant
