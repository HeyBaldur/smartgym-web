        <polygon points="405,420 412.05,440.29 433.53,440.73 416.41,453.71 422.63,474.27 405,462 387.37,474.27 393.59,453.71 376.47,440.73 397.95,440.29" fill="#FFCC00"/>
        <polygon points="315,395.88 322.05,416.17 343.53,416.61 326.41,429.59 332.63,450.15 315,437.88 297.37,450.15 303.59,429.59 286.47,416.61 307.95,416.17" fill="#FFCC00"/>
        <polygon points="249.12,330 256.17,350.29 277.65,350.73 260.53,363.71 266.75,384.27 249.12,372 231.49,384.27 237.71,363.71 220.59,350.73 242.07,350.29" fill="#FFCC00"/>
        <polygon points="225,240 232.05,260.29 253.53,260.73 236.41,273.71 242.63,294.27 225,282 207.37,294.27 213.59,273.71 196.47,260.73 217.95,260.29" fill="#FFCC00"/>
        <polygon points="249.12,150 256.17,170.29 277.65,170.73 260.53,183.71 266.75,204.27 249.12,192 231.49,204.27 237.71,183.71 220.59,170.73 242.07,170.29" fill="#FFCC00"/>
        <polygon points="315,84.12 322.05,104.41 343.53,104.85 326.41,117.83 332.63,138.39 315,126.12 297.37,138.39 303.59,117.83 286.47,104.85 307.95,104.41" fill="#FFCC00"/>
      </svg>

      <div>
        <p class="text-white/80 text-sm font-semibold leading-snug mb-1">
          European Union
        </p>
        <p class="text-white/40 text-xs leading-relaxed">
          Made in Poland · EU Member State
