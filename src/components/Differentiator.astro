---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="relative z-10 py-20 sm:py-24">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="relative rounded-3xl overflow-hidden border border-white/[0.07] bg-white/[0.025] p-10 sm:p-14 text-center">

      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[160px] bg-green-500/[0.05] blur-3xl rounded-full"></div>
      </div>

      <div class="relative">
        <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-5">
          {t('diff.label')}
        </p>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-2 text-balance">
          <span class="text-white/70">{t('diff.title')}</span>
        </h2>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-8 text-balance">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-green-500">
            {t('diff.highlight')}
          </span>
        </h2>

        <p class="text-white/55 text-lg font-light max-w-xl mx-auto mb-10 text-balance">
          {t('diff.body')}
        </p>

        <a
          href={`${base}${lang}/#download`}
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-green-400 to-green-500 text-black text-sm font-semibold rounded-xl hover:from-green-300 hover:to-green-400 transition-all duration-200 hover:scale-105 active:scale-95 shadow-lg shadow-green-500/20"
        >
          {t('diff.cta')}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
