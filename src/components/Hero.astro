---
import type { Lang } from '../utils/i18n';
import { useTranslations, langUrl } from '../utils/i18n';
import GooglePlayBadge from './GooglePlayBadge.astro';
import PhoneCarousel from './PhoneCarousel.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const chips = [
  { value: t('hero.stat1_value'), label: t('hero.stat1_label') },
  { value: t('hero.stat2_value'), label: t('hero.stat2_label') },
  { value: t('hero.stat3_value'), label: t('hero.stat3_label') },
  { value: t('hero.stat4_value'), label: t('hero.stat4_label') },
];
---

<section class="relative z-10 min-h-screen flex items-center pt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 md:py-28">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">

      <!-- Left: copy -->
      <div class="flex-1 text-center lg:text-left max-w-2xl mx-auto lg:mx-0">

        <div data-hero-badge class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/25 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-green-400 text-xs font-semibold tracking-wider uppercase">{t('hero.badge')}</span>
        </div>

        <h1 class="text-5xl sm:text-6xl md:text-7xl font-extrabold leading-none tracking-tight mb-6">
          <span data-hero-line class="block text-white">{t('hero.title1')}</span>
          <span data-hero-line class="block text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-400">{t('hero.title2')}</span>
        </h1>

        <p data-hero-tagline class="text-lg sm:text-xl text-white/60 font-light leading-relaxed mb-10 text-balance">
          {t('hero.tagline')}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center sm:items-center">
          <div data-hero-cta>
            <GooglePlayBadge
              lang={lang}
              href="#"
              class="shadow-xl shadow-black/40"
            />
          </div>
          <a
            data-hero-cta
            href={langUrl(lang, base, '#features')}
            class="inline-flex items-center justify-center gap-2 h-14 px-6 rounded-xl border border-white/15 text-white/80 hover:text-white hover:border-white/30 transition-all duration-200 text-sm font-medium hover:bg-white/[0.04]"
          >
            {t('hero.cta_secondary')}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 10.293a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 011.414-1.414l6 6z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>

        <!-- Stat chips -->
        <div data-hero-chips class="flex flex-wrap gap-2 justify-center lg:justify-start mt-8">
          {chips.map(({ value, label }) => (
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-green-400 font-bold text-sm">{value}</span>
              <span class="text-white/35 text-xs">{label}</span>
            </div>
          ))}
        </div>

        <p data-hero-sub class="text-white/25 text-xs mt-5">{t('hero.subtext')}</p>

      </div>

      <!-- Right: phone -->
      <PhoneCarousel
        screenshots={[
          { src: `${base}screenshots/home.jpg`,       alt: 'SmartGym home screen' },
          { src: `${base}screenshots/scanner.jpg`,    alt: 'Gym equipment scanner' },
          { src: `${base}screenshots/diagnostic.jpg`, alt: 'Smart fitness diagnostic' },
          { src: `${base}screenshots/routines.jpg`,   alt: 'Custom workout routines' },
          { src: `${base}screenshots/session.jpg`,    alt: 'Active training session' },
        ]}
      />

    </div>
  </div>
</section>
