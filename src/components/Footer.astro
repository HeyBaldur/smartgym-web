---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const langBase = `${base}${lang}/`;
const year = new Date().getFullYear();
---
<footer class="relative z-10 border-t border-white/[0.07] bg-black/60 backdrop-blur-sm py-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 mb-10">

      <div>
        <a href={langBase} class="flex items-center gap-2.5 mb-4 group w-fit" aria-label="SmartGym">
          <img
            src={`${base}icon.png`}
            alt="SmartGym icon"
            width="32"
            height="32"
            class="w-8 h-8 rounded-lg flex-shrink-0 object-cover"
          />
          <span class="font-bold text-white text-lg tracking-tight">SmartGym</span>
        </a>
        <p class="text-white/40 text-sm leading-relaxed">
          {t('footer.tagline')}
        </p>
        <p class="text-white/25 text-xs mt-4">
          &copy; {year} SmartGym Labs. All rights reserved.
        </p>
      </div>

      <div>
        <h3 class="text-white/40 text-[11px] font-semibold uppercase tracking-widest mb-4">{t('footer.nav_title')}</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={langBase} class="text-white/55 hover:text-green-400 text-sm transition-colors duration-200">
              {t('footer.home')}
            </a>
          </li>
          <li>
            <a href={`${langBase}privacy`} class="text-white/55 hover:text-green-400 text-sm transition-colors duration-200">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={`${langBase}terms`} class="text-white/55 hover:text-green-400 text-sm transition-colors duration-200">
              {t('footer.terms')}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-white/40 text-[11px] font-semibold uppercase tracking-widest mb-4">{t('footer.contact_title')}</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="mailto:contact.smartgymapp@gmail.com" class="text-white/55 hover:text-green-400 text-sm transition-colors duration-200">
              contact.smartgymapp@gmail.com
            </a>
          </li>
          <li>
            <a
              href="#"
              class="text-white/55 hover:text-green-400 text-sm transition-colors duration-200"
            >
              Google Play Store
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-8 border-t border-white/[0.05] flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-white/25 text-xs">{t('footer.made_in')}</p>
      <p class="text-white/15 text-xs">SmartGym Labs &mdash; {t('footer.beta')}</p>
    </div>

  </div>
</footer>
