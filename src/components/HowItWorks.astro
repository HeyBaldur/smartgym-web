---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative z-10 py-24 sm:py-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div data-how-header class="text-center mb-16">
      <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-3">{t('how.label')}</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">{t('how.title')}</h2>
      <p class="mt-4 text-white/45 text-lg font-light max-w-lg mx-auto">{t('how.subtitle')}</p>
    </div>

    <div class="relative">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-6">

        <!-- Step 1 -->
        <div data-how-step class="flex flex-col items-center text-center md:items-center">
          <div class="relative mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-600/10 border border-green-500/30 flex items-center justify-center shadow-lg shadow-green-500/10 group-hover:shadow-green-500/20 transition-shadow">
              <svg class="w-6 h-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            <div class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-green-500 text-black text-[10px] font-bold flex items-center justify-center">1</div>
          </div>
          <h3 class="text-white font-semibold text-base mb-2">{t('how.step1_title')}</h3>
          <p class="text-white/45 text-sm leading-relaxed">{t('how.step1_desc')}</p>
        </div>

        <!-- Step 2 -->
        <div data-how-step class="flex flex-col items-center text-center md:items-center">
          <div class="relative mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-600/10 border border-green-500/30 flex items-center justify-center shadow-lg shadow-green-500/10">
              <svg class="w-6 h-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
              </svg>
            </div>
            <div class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-green-500 text-black text-[10px] font-bold flex items-center justify-center">2</div>
          </div>
          <h3 class="text-white font-semibold text-base mb-2">{t('how.step2_title')}</h3>
          <p class="text-white/45 text-sm leading-relaxed">{t('how.step2_desc')}</p>
        </div>

        <!-- Step 3 -->
        <div data-how-step class="flex flex-col items-center text-center md:items-center">
          <div class="relative mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-600/10 border border-green-500/30 flex items-center justify-center shadow-lg shadow-green-500/10">
              <svg class="w-6 h-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
            </div>
            <div class="absolute -top-2 -right-2 w-5 h-5 rounded-full bg-green-500 text-black text-[10px] font-bold flex items-center justify-center">3</div>
          </div>
          <h3 class="text-white font-semibold text-base mb-2">{t('how.step3_title')}</h3>
          <p class="text-white/45 text-sm leading-relaxed">{t('how.step3_desc')}</p>
        </div>

      </div>
    </div>

  </div>
</section>
