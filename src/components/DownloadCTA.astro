---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';
import GooglePlayBadge from './GooglePlayBadge.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="download" class="relative z-10 py-24 sm:py-36 overflow-hidden">

  <!-- Glow rings -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-green-500/[0.06] scale-100"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full border border-green-500/[0.04]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[200px] bg-green-500/[0.06] blur-3xl rounded-full"></div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative">

    <div data-cta-container class="text-center">

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/25 mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
        <span class="text-green-400 text-xs font-semibold tracking-wider uppercase">{t('cta.badge')}</span>
      </div>

      <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-5 text-balance leading-none">
        {t('cta.title')}
      </h2>

      <p class="text-white/45 text-lg font-light mb-10 max-w-md mx-auto">
        {t('cta.subtitle')}
      </p>

      <div class="flex justify-center mb-6">
        <GooglePlayBadge lang={lang} href="#" class="shadow-2xl shadow-black/60 hover:scale-105 transition-transform duration-200" />
      </div>

      <p class="text-white/20 text-xs">
        {t('cta.disclaimer')}
      </p>

    </div>
  </div>
</section>
