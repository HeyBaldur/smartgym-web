---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';
import GooglePlayBadge from './GooglePlayBadge.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="download" class="relative z-10 py-24 sm:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="relative rounded-3xl overflow-hidden border border-green-500/20 bg-gradient-to-br from-green-950/40 via-black to-black p-10 sm:p-16 text-center">

      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[200px] bg-green-500/[0.07] blur-3xl rounded-full"></div>
      </div>

      <div class="relative">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/25 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-green-400 text-xs font-semibold tracking-wider uppercase">{t('cta.badge')}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-5 text-balance">
          {t('cta.title')}
        </h2>

        <p class="text-white/50 text-lg font-light mb-10 max-w-md mx-auto">
          {t('cta.subtitle')}
        </p>

        <div class="flex justify-center">
          <GooglePlayBadge lang={lang} href="#" class="shadow-2xl shadow-black/60" />
        </div>

        <p class="text-white/25 text-xs mt-6">
          {t('cta.disclaimer')}
        </p>
      </div>

    </div>
  </div>
</section>
