---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative z-10 py-24 sm:py-32">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">

      <!-- Avatar -->
      <div class="flex-shrink-0">
        <div class="relative">
          <div class="absolute inset-0 rounded-full bg-gradient-to-br from-green-400/20 to-green-600/10 blur-2xl scale-110 pointer-events-none"></div>
          <div
            class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-gradient-to-br from-zinc-800 to-zinc-900 border-2 border-white/[0.1] flex items-center justify-center overflow-hidden shadow-2xl"
            aria-label="Developer avatar"
          >
            <span class="text-6xl sm:text-7xl" aria-hidden="true">🏋️</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 text-center md:text-left">
        <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-3">{t('about.label')}</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          {t('about.name')}
        </h2>
        <p class="text-white/40 text-sm font-medium mb-5 italic">{t('about.title_text')}</p>
        <p class="text-white/55 text-base leading-relaxed mb-4">
          {t('about.body1')}
        </p>
        <p class="text-white/55 text-base leading-relaxed mb-8">
          {t('about.body2')}
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.04] border border-white/[0.08] text-white/40 text-sm">
            <span>📍</span>
            <span>{t('about.location')}</span>
            <!-- Polish flag SVG — emoji renders as "PL" on Windows -->
            <svg viewBox="0 0 40 26" width="22" height="14" role="img" aria-label="Polish flag" class="rounded flex-shrink-0">
              <rect width="40" height="13" fill="#FFFFFF"/>
              <rect y="13" width="40" height="13" fill="#DC143C"/>
            </svg>
          </div>
        </div>

        <!-- Contact / Booking block -->
        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.03] p-6">
          <h3 class="text-white font-semibold text-base mb-2">{t('about.contact_title')}</h3>
          <p class="text-white/45 text-sm leading-relaxed mb-5">{t('about.contact_body')}</p>
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <a
              href="https://calendly.com/smart-gym-app-assistance/30min"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-green-400 to-green-500 text-black text-sm font-semibold rounded-xl hover:from-green-300 hover:to-green-400 transition-all duration-200 hover:scale-105 active:scale-95 shadow-lg shadow-green-500/20"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
              {t('about.book_session')}
            </a>
            <span class="text-white/25 text-xs">{t('about.or_email')}</span>
            <a
              href="mailto:contact.smartgymapp@gmail.com"
              class="text-white/50 hover:text-green-400 text-sm transition-colors duration-200"
            >
              contact.smartgymapp@gmail.com
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
