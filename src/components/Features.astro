---

<section id="features" class="relative z-10 py-24 sm:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div data-features-header class="text-center mb-16">
      <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-3">{t('features.label')}</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t('features.title')}
      </h2>
      <p class="mt-4 text-white/45 text-lg font-light max-w-xl mx-auto">
        {t('features.subtitle')}
      </p>
    </div>

    <div data-feature-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map(({ key, svg }) => (
        <div
          data-feature-card
          class="group relative p-6 rounded-2xl border transition-all duration-300 cursor-default hover:-translate-y-1.5 hover:shadow-xl bg-white/[0.03] border-white/[0.07] hover:border-green-500/20 hover:bg-white/[0.055] hover:shadow-black/40"
        >
          <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 transition-all duration-300 bg-white/[0.06] border border-white/[0.08] group-hover:bg-green-500/10 group-hover:border-green-500/20">
            <svg
              class="w-5 h-5 text-white/50 group-hover:text-green-400 transition-colors duration-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              set:html={svg}
            />
          </div>

          <h3 class="text-white font-semibold text-base mb-2">
            {t(`features.items.${key}.title`)}
          </h3>
          <p class="text-white/45 text-sm leading-relaxed group-hover:text-white/55 transition-colors">
            {t(`features.items.${key}.desc`)}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
