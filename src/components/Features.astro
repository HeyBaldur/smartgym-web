---
import type { Lang } from '../utils/i18n';
import { useTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  { key: 'diagnostic', icon: '🧠', star: false },
  { key: 'system',     icon: '📋', star: false },
  { key: 'routines',   icon: '✏️',  star: false },
  { key: 'substitute', icon: '🔄', star: false },
  { key: 'scanner',    icon: '📸', star: true  },
  { key: 'session',    icon: '⏱️',  star: false },
  { key: 'history',    icon: '🏆', star: false },
  { key: 'metrics',    icon: '📊', star: false },
  { key: 'multilang',  icon: '🌍', star: false },
] as const;
---
<section id="features" class="relative z-10 py-24 sm:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16">
      <p class="text-green-400 text-sm font-semibold uppercase tracking-widest mb-3">{t('features.label')}</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {t('features.title')}
      </h2>
      <p class="mt-4 text-white/50 text-lg font-light max-w-xl mx-auto">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map(({ key, icon, star }) => (
        <div class:list={[
          'group relative p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1',
          star
            ? 'bg-green-500/[0.07] border-green-500/30 hover:border-green-500/50 hover:bg-green-500/[0.1]'
            : 'bg-white/[0.04] border-white/[0.07] hover:border-green-500/25 hover:bg-white/[0.06]',
        ]}>
          {star && (
            <div class="absolute top-4 right-4 flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-500/15 border border-green-500/30">
              <span class="text-green-400 text-[10px] font-semibold tracking-wide">{t('features.star_label')}</span>
            </div>
          )}
          <div class:list={[
            'w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-5',
            star
              ? 'bg-green-500/15 border border-green-500/30'
              : 'bg-green-500/10 border border-green-500/20',
          ]}>
            {icon}
          </div>
          <h3 class="text-white font-semibold text-base mb-2">{t(`features.items.${key}.title`)}</h3>
          <p class="text-white/50 text-sm leading-relaxed">{t(`features.items.${key}.desc`)}</p>
        </div>
      ))}
    </div>

  </div>
</section>
