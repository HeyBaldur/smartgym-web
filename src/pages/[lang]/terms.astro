---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import { SUPPORTED_LANGS, type Lang, useTranslations } from '../../utils/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';

export const getStaticPaths = (() => {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const entry = await getEntry('terms', lang);
if (!entry) throw new Error(`Terms entry not found for lang: ${lang}`);
const { Content } = await entry.render();
---
<BaseLayout
  lang={lang}
  title="Terms of Service — SmartGym"
  description="SmartGym terms of service. Read our usage terms and conditions."
>
  <Header lang={lang} />
  <main class="relative z-10 min-h-screen pt-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

      <a
        href={`${base}${lang}/`}
        class="inline-flex items-center gap-2 text-white/40 hover:text-green-400 text-sm font-medium transition-colors duration-200 mb-10"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
        {t('legal.back')}
      </a>

      <LanguageSwitcher lang={lang} pagePath="terms" />

      <div class="prose prose-invert max-w-none">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-white/[0.07]">
        <a
          href={`${base}${lang}/`}
          class="inline-flex items-center gap-2 text-white/40 hover:text-green-400 text-sm font-medium transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
          </svg>
          {t('legal.back')}
        </a>
      </div>

    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
